# Optional real weather data, obtained from OpenWeather for your account
OPENWEATHER_API_KEY=
WEATHER_CITY=Incheon
# Set to 0.0.0.0 only on an isolated trusted network
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Real sensor config (BCM GPIO numbers)
DHT22_GPIO=17
MQ2_GPIO=7
# REQUIRED: module-specific digital trigger polarity, set 0 or 1; blank means unconfigured
MQ2_ACTIVE_LEVEL=
PIR_GPIO=27
# Sensor data expires if the collector stops
SENSOR_STALE_SECONDS=20
